    "public.item_watch_status": {
      "columns": {
        "item_id": {
          "name": "item_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "watched": {
          "name": "watched",
          "type": "boolean",
          "primaryKey": false,
          "notNull": false
        },
        "disc_watch_count": {
          "name": "disc_watch_count",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "last_disc_watch": {
          "name": "last_disc_watch",
          "type": "date",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "\n  select\n    i.id as item_id,\n    case\n      when i.item_type <> 'film' then null\n      else i.watched_before_logging or count(w.id) > 0\n    end as watched,\n    count(w.id)::int as disc_watch_count,\n    max(w.watched_on) as last_disc_watch\n  from items i\n  left join watches w\n    on w.match_key = i.match_key\n    and w.format_id in (select id from viewing_formats where kind = 'disc')\n  group by i.id\n",
      "name": "item_watch_status",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
  },
